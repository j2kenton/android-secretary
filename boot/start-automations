#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot script: brings the phone-automations daemon back up after the phone starts.
# bin/setup installs it (Termux:Boot must be installed and opened once). A reboot also
# turns Wireless debugging off: the second line posts a card asking you to turn it back
# on, and reconnects adb by itself once you do.
termux-wake-lock
/data/data/com.termux/files/home/phone-automations/bin/automations start
exec /data/data/com.termux/files/home/phone-automations/bin/automations adb-wait
